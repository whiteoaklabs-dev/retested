---
import { MODELS, modelKey } from '../data/models';
const { model, label = false } = Astro.props as { model: string; label?: boolean };
const k = modelKey(model); const ab = MODELS.find(m => m.key === k)?.ab ?? model.slice(0, 2).toUpperCase();
---
{label ? <span class="mb"><i class={`md m-${k}`}>{ab}</i>{model}</span> : <i class={`md m-${k}`} title={model}>{ab}</i>}
