---
import Icon from './Icon.astro';
---
<div class="cta" id="newsletter">
  <div>
    <div class="eyebrow">Weekly · free</div>
    <h2 style="margin-top:8px">Know when your prompts break.</h2>
    <p>One short email a week covering which prompts still work after model updates, new playbooks, and tools worth your time.</p>
  </div>
  <div>
    <form class="js-api-form" data-endpoint="/api/subscribe" data-success="You're in. Watch your inbox for the next issue." novalidate>
      <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
      <label class="sr" for="nl-email" style="position:absolute;left:-9999px">Email</label>
      <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="you@work.com" />
      <button class="btn btn-primary" type="submit"><Icon name="mail" />Get re-test alerts</button>
    </form>
    <div class="note form-status" role="status" aria-live="polite">Free. Unsubscribe anytime.</div>
  </div>
</div>
