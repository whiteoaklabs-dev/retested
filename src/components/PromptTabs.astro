---
import Icon from './Icon.astro';
import ModelDot from './ModelDot.astro';
import type { UseCase } from '../data/useCases';
const { u, idp = 'p' } = Astro.props as { u: UseCase; idp?: string };
---
<div class="preview">
  <div class="tabs" role="tablist" aria-label="Model">
    {u.tests.map((t, i) => <button class="tab" role="tab" id={`${idp}-tab-${i}`} aria-controls={`${idp}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}><ModelDot model={t.model} />{t.model}</button>)}
  </div>
  {u.tests.map((t, i) => (
    <div class="panel" role="tabpanel" id={`${idp}-panel-${i}`} aria-labelledby={`${idp}-tab-${i}`} hidden={i !== 0}>
      <div class="testrow">
        {t.status === 'not-yet-tested'
          ? <span class="badge">Not yet tested on {t.model}</span>
          : <span class="badge fresh">Tested {t.testedOn} · {t.modelVersion} · {t.status}</span>}
        <span>Model version and date appear here after a recorded test run.</span>
      </div>
      <div style="position:relative">
        <pre class="prompt" id={`${idp}-prompt-${i}`}>{t.prompt}</pre>
        <div class="copy"><button class="btn copybtn" data-copy={`${idp}-prompt-${i}`}><Icon name="copy" size={14} />Copy</button></div>
      </div>
      {t.notes && <p class="muted">{t.notes}</p>}
    </div>
  ))}
</div>
