---
// Clearly labeled sponsored slot. Shows a "sponsor this spot" placeholder until sold.
import { BASE } from '../data/site';
import { sponsorFor } from '../data/sponsors';
interface Props { placement: string; label?: string }
const { placement, label } = Astro.props;
const s = sponsorFor(placement);
---
<aside class="sp-slot" aria-label="Sponsored">
  <span class="sp-tag">Sponsored</span>
  {s ? (
    <a class="sp-body" href={s.url} rel="sponsored noopener" target="_blank">
      <strong>{s.name}</strong><span>{s.blurb}</span><span class="sp-cta">Visit {s.name} →</span>
    </a>
  ) : (
    <div class="sp-body sp-empty">
      <strong>Your tool here</strong>
      <span>Sponsor this spot{label ? ` in ${label}` : ''}: $199/mo, live within 24 hours. Always labeled, never affects test results. <a href={`${BASE}/get-featured/`}>See all placements</a></span>
      <a class="sp-cta btn btn-primary" href="https://buy.stripe.com/28EdR8fQjevH3cu27GfQI02" rel="noopener">Buy now · $199/mo</a>
    </div>
  )}
</aside>
<style>
.sp-slot{position:relative;border:1px dashed var(--line2);border-radius:16px;background:var(--panel);margin:24px 0}
.sp-tag{position:absolute;top:-10px;left:16px;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:999px;background:var(--bg);border:1px solid var(--line2);color:var(--muted)}
.sp-body{display:flex;flex-wrap:wrap;align-items:center;gap:6px 16px;padding:20px;color:inherit;text-decoration:none}
.sp-body strong{font-size:16px}
.sp-body span{color:var(--muted);font-size:14px;flex:1 1 320px}
.sp-body .sp-cta{flex:0 0 auto;color:var(--accent);font-weight:600}
.sp-empty .sp-cta{color:#fff}
a.sp-body:hover{background:color-mix(in srgb,var(--accent) 6%,transparent);border-radius:16px}
</style>
