---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, BASE } from '../data/site';
interface Props { title: string; description: string; schema?: object[] }
const { title, description, schema = [] } = Astro.props;
const canonical = SITE.origin + Astro.url.pathname;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url };
const path = Astro.url.pathname;
const nav = [['Playbooks', '/use-cases/'], ['Tools', '/tools/'], ['Releases', '/releases/'], ['How we test', '/methodology/'], ['Get featured', '/get-featured/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title === SITE.name ? `${SITE.name} | Tested AI playbooks for real work` : `${title} | ${SITE.name}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href={BASE + '/sitemap-index.xml'} />
  <link rel="icon" href={BASE + '/favicon.svg'} type="image/svg+xml" />
  <meta name="theme-color" content="#08090b" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Retested" />
  <meta name="twitter:card" content="summary" />
  <script is:inline>try{const t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  {[org, ...schema].map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a href="#main" style="position:absolute;left:-9999px" onfocus="this.style.left='8px'">Skip to content</a>
  <nav class="nav" aria-label="Main">
    <div class="wrap">
      <a class="brand" href={BASE + '/'}><span class="logo"><Icon name="refresh" /></span>Retested</a>
      <div class="navlinks" id="navlinks">
        {nav.map(([l, h]) => <a href={BASE + h} aria-current={path.startsWith(BASE + h) ? 'page' : undefined}>{l}</a>)}
      </div>
      <div class="right">
        <button class="iconbtn" id="theme" aria-label="Toggle color theme"><span class="i-sun"><Icon name="sun" /></span><span class="i-moon"><Icon name="moon" /></span></button>
        <a class="btn btn-primary hide-sm" href="#newsletter">Get re-test alerts</a>
        <button class="iconbtn menu-toggle" aria-label="Menu" onclick="document.getElementById('navlinks').classList.toggle('open')"><Icon name="menu" /></button>
      </div>
    </div>
  </nav>
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="wrap cols">
      <div>
        <a class="brand" href={BASE + '/'} style="color:var(--text)"><span class="logo"><Icon name="refresh" /></span>Retested</a>
        <p style="max-width:300px;margin-top:12px">Tested AI playbooks for real work. Prompts are dated by model and re-tested when the models change.</p>
      </div>
      <div><h4>Library</h4><a href={BASE + '/use-cases/'}>Playbooks</a><a href={BASE + '/tools/'}>Tools</a><a href={BASE + '/releases/'}>Releases</a></div>
      <div><h4>Trust</h4><a href={BASE + '/methodology/'}>How we test</a><a href={BASE + '/disclosure/'}>Disclosure</a></div>
      <div><h4>Makers</h4><a href={BASE + '/get-featured/'}>Get featured</a><a href={BASE + '/newsletter/'}>Newsletter</a></div>
    </div>
    <div class="wrap" style="margin-top:32px">© 2026 Retested. Paid placements are always labeled and never change test results.</div>
  </footer>
  <script is:inline>
    document.getElementById('theme').onclick=()=>{const r=document.documentElement;r.dataset.theme=r.dataset.theme==='light'?'dark':'light';try{localStorage.setItem('theme',r.dataset.theme)}catch(e){}};
    document.querySelectorAll('[data-copy]').forEach(btn=>btn.addEventListener('click',async()=>{const el=document.getElementById(btn.dataset.copy);try{await navigator.clipboard.writeText(el.innerText)}catch(e){}const o=btn.innerHTML;btn.classList.add('done');btn.textContent='Copied';setTimeout(()=>{btn.classList.remove('done');btn.innerHTML=o},1600)}));
    document.querySelectorAll('[role=tablist]').forEach(tl=>{const tabs=[...tl.querySelectorAll('[role=tab]')];tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>{x.setAttribute('aria-selected',x===t);document.getElementById(x.getAttribute('aria-controls')).hidden=x!==t})}))});
  </script>
</body>
</html>
