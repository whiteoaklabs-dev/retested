---
import { BASE } from "../data/site";
import { SITE } from '../data/site';
interface Props { title: string; description: string; schema?: object[] }
const { title, description, schema = [] } = Astro.props;
const canonical = SITE.origin + Astro.url.pathname;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title === SITE.name ? title : `${title} | ${SITE.name}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href={BASE+"/sitemap-index.xml"} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:type" content="website" />
  {[org, ...schema].map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <style is:global>
    body{font-family:system-ui,sans-serif;max-width:860px;margin:0 auto;padding:0 1rem;line-height:1.6;color:#1a1a1a}
    header,footer{display:flex;gap:1rem;flex-wrap:wrap;padding:1rem 0;border-bottom:1px solid #ddd} footer{border:0;border-top:1px solid #ddd;font-size:.9rem;margin-top:3rem}
    a{color:#0b57d0} .badge{display:inline-block;padding:.1rem .5rem;border-radius:4px;font-size:.8rem;font-weight:600}
    .untested{background:#eee;color:#555} .fresh{background:#d7f5dc;color:#11632a} .stale{background:#ffe7b3;color:#7a4b00}
    .card{border:1px solid #ddd;border-radius:8px;padding:1rem;margin:1rem 0} pre{white-space:pre-wrap;background:#f6f6f6;padding:.75rem;border-radius:6px}
    .answer{background:#f0f6ff;padding:1rem;border-radius:8px} .sponsored{font-size:.75rem;color:#7a4b00}
    table{border-collapse:collapse;width:100%} td,th{border:1px solid #ddd;padding:.4rem;text-align:left}
  </style>
</head>
<body>
  <header><a href={BASE+"/"}><strong>Retested</strong></a><a href={BASE+"/use-cases/"}>Use cases</a><a href={BASE+"/tools/"}>Tools</a><a href={BASE+"/releases/"}>Releases</a><a href={BASE+"/get-featured/"}>Get featured</a><a href={BASE+"/newsletter/"}>Newsletter</a></header>
  <main><slot /></main>
  <footer><span>© 2026 Retested</span><a href={BASE+"/methodology/"}>How we test</a><a href={BASE+"/disclosure/"}>Affiliate &amp; sponsor disclosure</a></footer>
</body>
</html>
