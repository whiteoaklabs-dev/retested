---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, BASE } from '../data/site';
import { CATEGORIES } from '../data/useCases';
import { catSlug } from '../data/categories';
interface Props { title: string; description: string; schema?: object[]; noindex?: boolean; crumbs?: [string, string][]; ogType?: string }
const { title, description, schema = [], noindex = false, crumbs = [], ogType = 'website' } = Astro.props;
const canonical = SITE.origin + Astro.url.pathname;
const fullTitle = title === SITE.name ? `${SITE.name} | Tested AI playbooks for real work` : `${title} | ${SITE.name}`;
// Per-page OG image, rendered after build by scripts/og.mjs from this page's <title>.
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '--') || 'home';
const ogImage = `${SITE.origin}/og/${ogSlug}.png`;
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION || SITE.googleSiteVerification;
const org = { '@context': 'https://schema.org', '@type': 'Organization', '@id': SITE.url + '/#org', name: SITE.name, url: SITE.url + '/', logo: SITE.url + '/favicon.svg', description: SITE.tagline };
const crumbLd = crumbs.length ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['Home', '/'], ...crumbs].map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, item: SITE.origin + href })) }] : [];
const path = Astro.url.pathname;
const nav = [['Playbooks', '/use-cases/'], ['Tools', '/tools/'], ['Releases', '/releases/'], ['Prompt packs', '/prompt-packs/'], ['How we test', '/methodology/'], ['Submit a tool', '/submit/'], ['Sponsor', '/get-featured/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {gsc && <meta name="google-site-verification" content={gsc} />}
  <link rel="alternate" type="application/rss+xml" title="Retested releases" href={SITE.origin + '/releases/rss.xml'} />
  <link rel="sitemap" href={BASE + '/sitemap-index.xml'} />
  <link rel="icon" href={BASE + '/favicon.svg'} type="image/svg+xml" />
  <meta name="theme-color" content="#08090b" />
  <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:type" content={ogType} /><meta property="og:site_name" content="Retested" /><meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
  <script is:inline>try{const t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  {[org, ...crumbLd, ...schema].map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};</script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body>
  <a href="#main" style="position:absolute;left:-9999px" onfocus="this.style.left='8px'">Skip to content</a>
  <nav class="nav" aria-label="Main">
    <div class="wrap">
      <a class="brand" href={BASE + '/'}><span class="logo"><Icon name="refresh" /></span>Retested</a>
      <div class="navlinks" id="navlinks">
        {nav.map(([l, h]) => <a href={BASE + h} aria-current={path.startsWith(BASE + h) ? 'page' : undefined}>{l}</a>)}
      </div>
      <div class="right">
        <button class="iconbtn" id="theme" aria-label="Toggle color theme"><span class="i-sun"><Icon name="sun" /></span><span class="i-moon"><Icon name="moon" /></span></button>
        <a class="btn btn-primary hide-sm" href="#newsletter">Get re-test alerts</a>
        <button class="iconbtn menu-toggle" aria-label="Menu" onclick="document.getElementById('navlinks').classList.toggle('open')"><Icon name="menu" /></button>
      </div>
    </div>
  </nav>
  <main id="main">
    {crumbs.length > 0 && <div class="wrap"><nav class="crumbs site-crumbs" aria-label="Breadcrumb"><a href={BASE + '/'}>Home</a>{crumbs.map(([n, h], i) => <><span>/</span>{i === crumbs.length - 1 ? <span aria-current="page">{n}</span> : <a href={BASE + h}>{n}</a>}</>)}</nav></div>}
    <slot />
  </main>
  <footer class="site">
    <div class="wrap cols">
      <div>
        <a class="brand" href={BASE + '/'} style="color:var(--text)"><span class="logo"><Icon name="refresh" /></span>Retested</a>
        <p style="max-width:300px;margin-top:12px">Tested AI playbooks for real work. Prompts are dated by model and re-tested when the models change.</p>
      </div>
      <div><h4>Library</h4><a href={BASE + '/use-cases/'}>Playbooks</a>{CATEGORIES.map(c => <a href={`${BASE}/ai-for/${catSlug(c)}/`}>AI for {c}</a>)}<a href={BASE + '/tools/'}>Tools</a><a href={BASE + '/releases/'}>Releases</a></div>
      <div><h4>Trust</h4><a href={BASE + '/methodology/'}>How we test</a><a href={BASE + '/disclosure/'}>Disclosure</a></div>
      <div><h4>Makers</h4><a href={BASE + '/submit/'}>Submit a tool (free)</a><a href={BASE + '/get-featured/'}>Sponsor: buy a placement</a><a href={BASE + '/prompt-packs/'}>Prompt packs</a><a href={BASE + '/newsletter/'}>Newsletter</a></div>
    </div>
    <div class="wrap" style="margin-top:32px">© 2026 Retested. Paid placements are always labeled and never change test results.</div>
  </footer>
  <script is:inline>
    document.getElementById('theme').onclick=()=>{const r=document.documentElement;r.dataset.theme=r.dataset.theme==='light'?'dark':'light';try{localStorage.setItem('theme',r.dataset.theme)}catch(e){}};
    document.querySelectorAll('[data-copy]').forEach(btn=>btn.addEventListener('click',async()=>{const el=document.getElementById(btn.dataset.copy);try{await navigator.clipboard.writeText(el.innerText)}catch(e){}const o=btn.innerHTML;btn.classList.add('done');btn.textContent='Copied';setTimeout(()=>{btn.classList.remove('done');btn.innerHTML=o},1600)}));
    document.querySelectorAll('[role=tablist]').forEach(tl=>{const tabs=[...tl.querySelectorAll('[role=tab]')];tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>{x.setAttribute('aria-selected',x===t);document.getElementById(x.getAttribute('aria-controls')).hidden=x!==t})}))});
    document.querySelectorAll('[data-ptabs]').forEach(pt=>{const b=pt.querySelector('[data-more-btn]'),m=pt.querySelector('[data-more-menu]'),lb=pt.querySelector('[data-more-label]');if(!b)return;const set=o=>{m.hidden=!o;b.setAttribute('aria-expanded',o)};b.onclick=e=>{e.stopPropagation();set(m.hidden)};document.addEventListener('click',e=>{if(!b.parentElement.contains(e.target))set(false)});document.addEventListener('keydown',e=>{if(e.key==='Escape')set(false)});pt.querySelectorAll('[role=tab]').forEach(t=>t.addEventListener('click',()=>{const inMenu=m.contains(t);b.dataset.active=inMenu;lb.textContent=inMenu?t.dataset.name:'More AIs';if(inMenu)set(false)}))});
  </script>
<script is:inline>
document.querySelectorAll('form.js-api-form').forEach(f=>{
  const st=f.querySelector('.form-status')||f.parentElement.querySelector('.form-status');
  const btn=f.querySelector('[type=submit]');
  f.addEventListener('submit',async e=>{
    e.preventDefault();
    if(!f.checkValidity()){f.reportValidity();return;}
    const label=btn.innerHTML;btn.disabled=true;btn.textContent='Sending…';
    st.classList.remove('is-error','is-ok');
    try{
      const r=await fetch(f.dataset.endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(f)))});
      const d=await r.json().catch(()=>({}));
      if(r.ok&&d.ok){f.reset();st.textContent=f.dataset.success;st.classList.add('is-ok');}
      else{st.textContent=d.error||'Something went wrong. Please try again.';st.classList.add('is-error');}
    }catch{st.textContent='Network error. Please try again.';st.classList.add('is-error');}
    btn.disabled=false;btn.innerHTML=label;
  });
});
</script>
</body>
</html>
