---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Payment received" description="Your Retested placement is paid and goes live within 24 hours." noindex>
  <div class="wrap">
    <div class="page-head" style="text-align:center;margin:0 auto;max-width:640px">
      <div class="eyebrow">Payment received</div>
      <h1>Thanks, payment received.</h1>
      <p style="margin-inline:auto">Stripe has emailed your receipt. Your placement goes live within 24 hours, labeled "Sponsored". Paid placements never change test results.</p>
      <p style="margin-inline:auto">Questions? <a href="/get-featured/#contact">Contact us</a>.</p>
      <p style="margin-top:24px"><a class="btn btn-primary" href="/">Back to Retested <Icon name="arrow" /></a></p>
    </div>
  </div>
</Base>
