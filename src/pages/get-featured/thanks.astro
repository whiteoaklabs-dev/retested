---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Thanks for your order" description="Your Retested placement order is confirmed." noindex>
  <div class="wrap">
    <div class="page-head" style="text-align:center;margin:0 auto;max-width:640px">
      <div class="eyebrow">Payment received</div>
      <h1>Thanks, you're in.</h1>
      <p style="margin-inline:auto">Stripe has emailed your receipt. We'll review your tool and reply by email with next steps, usually within two business days. Paid placements are always labeled and never change test results.</p>
      <p style="margin-inline:auto">Questions? Use the <a href="/get-featured/#contact">contact form</a>.</p>
      <p style="margin-top:24px"><a class="btn btn-primary" href="/">Back to Retested <Icon name="arrow" /></a></p>
    </div>
  </div>
</Base>
