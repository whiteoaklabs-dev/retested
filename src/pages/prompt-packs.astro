---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const buyUrl = 'https://buy.stripe.com/9B628q5bF0ER5kCh2AfQI03';
const samples = [
  { t: 'Write a job quote a homeowner can say yes to', p: `You write short, clear job quotes for a [TRADE] business.\n\nJob: [JOB DESCRIPTION]\nMaterials/labor notes: [NOTES]\nPrice: $[AMOUNT]\nTimeline: [START] to [FINISH]\nDeposit: [DEPOSIT % or $]\n\nWrite a friendly quote email I can send today. Include what's included, what's not, the total, the deposit, and a clear next step. Keep it under 200 words. No slang.` },
  { t: 'Polite late-payment reminder (first chase)', p: `Write a polite first late-payment email for my [TRADE] business.\n\nCustomer: [NAME]\nJob: [JOB]\nInvoice #: [NUMBER]\nAmount due: $[AMOUNT]\nDue date: [DATE]\nMy name / business: [NAME]\n\nTone: friendly and firm, not angry. Ask them to pay or tell me if there's a problem. Include a placeholder for the pay link: [PAY LINK]. Under 120 words.` },
  { t: 'Ask for a Google review after a finished job', p: `Write a short text message I can send after finishing a [TRADE] job.\n\nCustomer first name: [NAME]\nWhat we did: [JOB]\nReview link: [GOOGLE REVIEW LINK]\n\nThank them, mention one specific thing we did well, and ask for a Google review. One short paragraph. Casual but professional.` },
];
---
<Base title="Prompt packs" description="Ready-to-use AI prompt packs for small businesses. Start with the Home Services pack — 40 copy-paste prompts for $19.">
  <div class="wrap">
    <div class="page-head" style="text-align:center;margin:0 auto;max-width:760px">
      <div class="eyebrow">For sale</div>
      <h1>Prompt packs</h1>
      <p style="margin-inline:auto">Copy-paste prompt bundles for one kind of work. Plain English. Works in ChatGPT, Claude, Grok, or Muse.</p>
    </div>

    <section class="hero-pack">
      <div>
        <span class="pk-tag">Home services</span>
        <h2>AI Prompt Pack for Home Service Businesses</h2>
        <p>For contractors, cleaners, and landscapers. Forty prompts you can paste into any AI for quotes, invoices, late payments, reviews, scheduling texts, and social posts.</p>
        <ul class="bul">
          <li>40 copy-paste prompts with fill-in brackets</li>
          <li>Quotes, invoices, late payments, reviews, scheduling, social</li>
          <li>Instant PDF download after checkout — $19 one-time</li>
        </ul>
        <a class="btn btn-primary" href={buyUrl} rel="noopener">Get the full prompt pack — $19</a>
      </div>
      <div class="price-card">
        <div class="price">$19</div>
        <div class="muted">One-time · PDF download</div>
        <a class="btn btn-primary" style="width:100%;justify-content:center;margin-top:16px" href={buyUrl} rel="noopener">Buy now</a>
        <p class="muted" style="font-size:12px;margin-top:12px">Secure checkout via Stripe. You'll get the download link right after payment.</p>
      </div>
    </section>

    <section style="max-width:860px;margin:48px auto 0">
      <h2 style="font-size:22px;text-align:center;margin-bottom:8px">Sample prompts</h2>
      <p class="muted" style="text-align:center;margin-bottom:24px">Three free samples from the pack. The full PDF has all 40.</p>
      <div class="samples">
        {samples.map(s => (
          <div class="sample">
            <h3>{s.t}</h3>
            <pre><code>{s.p}</code></pre>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:28px">
        <a class="btn btn-primary" href={buyUrl} rel="noopener"><Icon name="copy" />Get all 40 prompts — $19</a>
      </div>
    </section>

    <section style="max-width:960px;margin:56px auto 0">
      <h2 style="font-size:18px;margin-bottom:14px">More packs planned</h2>
      <div class="pk-grid">
        <div class="pk"><span class="pk-tag">Planned</span><h3>Inbox & admin pack</h3><p>Triage, reply drafts, and follow-up prompts for a small-business inbox.</p></div>
        <div class="pk"><span class="pk-tag">Planned</span><h3>Sales follow-up pack</h3><p>Lead qualification, fast first replies, and follow-up sequences.</p></div>
        <div class="pk"><span class="pk-tag">Planned</span><h3>Support pack</h3><p>Help-doc answers, escalation rules, and tone guides for support work.</p></div>
      </div>
    </section>
  </div>
</Base>
<style>
.hero-pack{display:grid;grid-template-columns:1.4fr .8fr;gap:28px;max-width:960px;margin:28px auto 0;padding:28px;border:1px solid var(--line2);border-radius:20px;background:var(--panel)}
@media (max-width:760px){.hero-pack{grid-template-columns:1fr}}
.hero-pack h2{font-size:26px;margin:8px 0 10px}
.bul{margin:14px 0 20px;padding-left:18px;color:var(--muted);font-size:14px;line-height:1.55}
.bul li{margin:4px 0}
.price-card{padding:22px;border:1px solid var(--line2);border-radius:16px;background:var(--bg2);text-align:center;align-self:start}
.price{font-size:48px;font-weight:700;letter-spacing:-.03em;line-height:1}
.samples{display:grid;gap:16px}
.sample{padding:18px;border:1px solid var(--line2);border-radius:14px;background:var(--panel)}
.sample h3{margin:0 0 10px;font-size:16px}
.sample pre{margin:0;white-space:pre-wrap;background:var(--bg2);border:1px solid var(--line2);border-radius:10px;padding:12px 14px;font-size:12.5px;line-height:1.5;overflow-x:auto}
.pk-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media (max-width:760px){.pk-grid{grid-template-columns:1fr}}
.pk{position:relative;padding:22px;border:1px solid var(--line2);border-radius:16px;background:var(--panel)}
.pk h3{margin:8px 0 6px;font-size:17px}.pk p{margin:0;color:var(--muted);font-size:14px}
.pk-tag{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
</style>
