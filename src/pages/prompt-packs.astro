---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const packs = [
  { t: 'Inbox & admin pack', d: 'Triage, reply drafts, and follow-up prompts for a small-business inbox.' },
  { t: 'Sales follow-up pack', d: 'Lead qualification, fast first replies, and follow-up sequences.' },
  { t: 'Support pack', d: 'Help-doc answers, escalation rules, and tone guides for support agents.' },
];
---
<Base title="Prompt packs" description="Bundles of Retested prompts for ChatGPT, Claude, Grok, and Muse, grouped by job. Join the waitlist.">
  <div class="wrap">
    <div class="page-head" style="text-align:center;margin:0 auto;max-width:760px"><div class="eyebrow">Coming soon</div><h1>Prompt packs</h1><p style="margin-inline:auto">Ready-to-use bundles of prompts for one job, with versions for each model and notes on what to check before you trust the output. Packs aren't for sale yet. Join the waitlist and we'll email you when the first one is ready.</p></div>
    <div class="pk-grid">
      {packs.map(p => <div class="pk"><span class="pk-tag">Planned</span><h3>{p.t}</h3><p>{p.d}</p></div>)}
    </div>
    <section id="waitlist" style="max-width:560px;margin:40px auto 0;padding:28px;border:1px solid var(--line2);border-radius:20px;background:var(--panel);text-align:center">
      <h2 style="font-size:22px;font-weight:640">Join the waitlist</h2>
      <p class="muted">One email when packs launch, plus the weekly newsletter. Unsubscribe anytime.</p>
      <form class="js-api-form pk-form" data-endpoint="/api/subscribe" data-success="You're on the list. We'll email you when packs launch." novalidate>
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
        <input type="hidden" name="waitlist" value="prompt-packs" />
        <label for="pk-email" style="position:absolute;left:-9999px">Email</label>
        <input id="pk-email" name="email" type="email" required autocomplete="email" placeholder="you@work.com" />
        <button class="btn btn-primary" type="submit"><Icon name="mail" />Join waitlist</button>
      </form>
      <div class="note form-status" role="status" aria-live="polite" style="margin-top:10px"></div>
    </section>
  </div>
</Base>
<style>
.pk-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:960px;margin:0 auto}
@media (max-width:760px){.pk-grid{grid-template-columns:1fr}}
.pk{position:relative;padding:22px;border:1px solid var(--line2);border-radius:16px;background:var(--panel)}
.pk h3{margin:8px 0 6px;font-size:17px}.pk p{margin:0;color:var(--muted);font-size:14px}
.pk-tag{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.pk-form{display:flex;gap:8px;margin-top:16px}.pk-form input[type=email]{flex:1;min-width:0;height:44px;border-radius:11px;border:1px solid var(--line2);background:var(--bg2);color:var(--text);font:inherit;padding:0 14px}.pk-form input[type=email]:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
@media (max-width:480px){.pk-form{flex-direction:column}}
</style>
