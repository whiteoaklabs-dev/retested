---
import Base from '../../layouts/Base.astro';
import { releases, type Release } from '../../data/releases';
import { useCaseBySlug } from '../../data/useCases';
import { BASE } from '../../data/site';
export function getStaticPaths() { return releases.map(r => ({ params: { slug: r.slug }, props: { r } })); }
const { r } = Astro.props as { r: Release };
const schema = [{ '@context': 'https://schema.org', '@type': 'NewsArticle', headline: r.title, datePublished: r.date }];
---
<Base title={r.title} description={r.summary.slice(0, 155)} schema={schema} noindex={r.slug === 'feed-placeholder'} crumbs={[['Releases', '/releases/'], [r.title, `/releases/${r.slug}/`]]}>
  <div class="wrap prose">
    <div class="page-head"><time class="mono muted" datetime={r.date}>{r.date}</time><h1>{r.title}</h1>
      {r.sponsored && <p class="disclose">Sponsored release spotlight</p>}<p>{r.summary}</p></div>
    {r.affects.length > 0 && <><h2>Playbooks this changes</h2><ul>{r.affects.map(s => { const u = useCaseBySlug(s); return u && <li><a href={`${BASE}/use-cases/${u.slug}/`}>{u.title}</a></li>; })}</ul></>}
    <p>Re-test queued: {r.retestQueued ? 'yes' : 'no'}</p>
  </div>
</Base>
