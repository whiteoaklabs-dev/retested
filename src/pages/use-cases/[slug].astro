---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ModelDot from '../../components/ModelDot.astro';
import { MORE } from '../../data/models';
import PromptTabs from '../../components/PromptTabs.astro';
import SponsorSlot from '../../components/SponsorSlot.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { useCases, planned, type UseCase } from '../../data/useCases';
import { toolBySlug } from '../../data/tools';
import { SITE, BASE } from '../../data/site';
import { catSlug } from '../../data/categories';
export function getStaticPaths() { return useCases.map(u => ({ params: { slug: u.slug }, props: { u } })); }
const { u } = Astro.props as { u: UseCase };
const url = `${SITE.url}/use-cases/${u.slug}/`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'HowTo', name: u.title, description: u.summary, step: u.setup.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: u.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'Article', headline: u.title, description: u.summary, datePublished: u.published, dateModified: u.updated, url, mainEntityOfPage: url, image: `${SITE.url}/og/use-cases--${u.slug}.png`, articleSection: u.category, author: { '@type': 'Organization', name: SITE.name, url: SITE.url + '/' }, publisher: { '@id': SITE.url + '/#org' } },
];
const pinned = (u.related ?? []).map(s => useCases.find(x => x.slug === s)).filter(Boolean) as UseCase[];
const others = [...pinned, ...useCases.filter(x => x.slug !== u.slug && !pinned.includes(x)).sort((a, b) => Number(b.category === u.category) - Number(a.category === u.category))];
const related = [...others.map(x => ({ t: x.title, h: `${BASE}/use-cases/${x.slug}/`, c: x.category })), ...planned.filter(p => p.category === u.category).slice(0, 2).map(p => ({ t: p.title, h: '', c: p.category }))].slice(0, 4);
const desc = u.summary.length > 158 ? u.summary.slice(0, u.summary.lastIndexOf(' ', 155)) + '…' : u.summary;
const toc = [['answer', 'Short answer'], ['results', 'Test results'], ['prompts', 'Prompts'], ...(u.example ? [['example', 'Worked example']] : []), ['setup', 'Agent setup'], ['tools', 'Best tools'], ['faq', 'FAQ']].filter(([id]) => (id !== 'results' || u.tests.some(t => t.status !== 'not-yet-tested')) && (id !== 'tools' || u.toolPicks.some(p => toolBySlug(p.slug))));
---
<Base title={u.title} description={desc} schema={schema} ogType="article" crumbs={[['Playbooks', '/use-cases/'], [u.category, `/ai-for/${catSlug(u.category)}/`], [u.title, `/use-cases/${u.slug}/`]]}>
  <div class="wrap">
    <header class="uc-hero">
      <h1>{u.title}</h1>
      <div class="meta">
        <span><span class="cat-ic"><Icon name={u.category} /></span>{u.category}</span>
        <span><Icon name="calendar" />Updated {u.updated}</span>
        <span class="dots">{u.tests.map(t => <ModelDot model={t.model} />)}</span><span class="muted" style="font-size:12px">+{MORE.length - 1} more AIs</span>
      </div>
    </header>
    <div class="doc">
      <article>
        <div class="answer" id="answer"><div class="eyebrow">Short answer</div>{u.summary}</div>

        {u.tests.some(t => t.status !== 'not-yet-tested') && <>
        <h2 id="results">Test results</h2>
        <table class="matrix">
          <thead><tr><th>Model</th><th>Version</th><th>Tested</th><th>Result</th></tr></thead>
          <tbody>{u.tests.filter(t => t.status !== 'not-yet-tested').map(t => <tr><td><span style="display:inline-flex;gap:8px;align-items:center;font-weight:550"><ModelDot model={t.model} />{t.model}</span></td><td class="muted">{t.modelVersion ?? '—'}</td><td class="muted">{t.testedOn ?? '—'}</td><td><span class="badge fresh">{t.status}</span></td></tr>)}</tbody>
        </table>
        <p class="disclose">We don't publish a "best model" until real runs are recorded. <a href={BASE + '/methodology/'} style="color:var(--accent)">How we test →</a></p>
        </>}

        <h2 id="prompts">Prompts by model</h2>
        <PromptTabs u={u} idp="uc" />

        {u.example && <>
        <h2 id="example">Worked example</h2>
        <p>{u.example.scenario}</p>
        <h3 style="font-size:16px;margin-top:20px">What you paste in</h3>
        <pre class="example"><code>{u.example.input}</code></pre>
        <h3 style="font-size:16px;margin-top:20px">What a good result looks like</h3>
        <pre class="example"><code>{u.example.output}</code></pre>
        {u.example.notes && <p class="muted">{u.example.notes}</p>}
        <p class="disclose">Illustrative example with made-up names and numbers, written to show the expected shape of the output.</p>
        </>}

        <h2 id="setup">Agent setup</h2>
        <p class="muted" style="margin-top:-6px">Works with: <strong style="color:var(--text)">{u.setup.agent}</strong></p>
        <ol class="steps" style="margin-top:20px">{u.setup.steps.map(s => <li>{s}</li>)}</ol>
        <div class="callout"><Icon name="shield" /><div><strong>Human approval step.</strong> {u.setup.approvalStep}</div></div>
        <h3 style="font-size:16px;margin-top:28px">Where it usually breaks</h3>
        <ul class="fails">{u.setup.failureModes.map(f => <li>{f}</li>)}</ul>

        {u.toolPicks.some(p => toolBySlug(p.slug)) && <>
        <h2 id="tools">Best tools for this job</h2>
        <p class="disclose">Some links may become affiliate links. They never change our picks. <a href={BASE + '/disclosure/'} style="color:var(--accent)">Disclosure</a></p>
        <div class="picks">
          {u.toolPicks.filter(p => toolBySlug(p.slug)).map((p, i) => { const t = toolBySlug(p.slug)!; return (
            <div class="pick">
              <div style="display:flex;align-items:center;gap:10px"><span class="tlogo" data-h={t.name.length} style="width:32px;height:32px;font-size:13px;border-radius:9px">{t.name[0]}</span><div><div class="rank">PICK #{i + 1}</div><h3><a href={`${BASE}/tools/${t.slug}/`}>{t.name}</a></h3></div></div>
              <p><strong style="color:var(--text)">Why:</strong> {p.why}</p>
              <p><strong style="color:var(--text)">Skip if:</strong> {p.whenNot}</p>
              <a class="btn" href={t.affiliateUrl ?? t.url} rel={t.affiliateUrl ? 'sponsored nofollow noopener' : 'nofollow noopener'} target="_blank">Visit {t.name} <Icon name="external" size={14} /></a>
            </div>); })}
        </div>
        </>}

        <h2 id="faq">FAQ</h2>
        <div class="faq">{u.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>

        <h2>Related playbooks</h2>
        <p class="muted" style="margin-top:-6px">More in <a href={`${BASE}/ai-for/${catSlug(u.category)}/`} style="color:var(--accent)">AI for {u.category}</a> · <a href={BASE + '/use-cases/'} style="color:var(--accent)">all playbooks</a></p>
        <div class="cards">{related.map(r => r.h
          ? <a class="uc" href={r.h} style="min-height:auto"><div class="top"><span class="cat-ic"><Icon name={r.c} /></span><span class="cat">{r.c}</span><span class="status ready">READY</span></div><h3>{r.t}</h3></a>
          : <div class="uc wip" style="min-height:auto"><div class="top"><span class="cat-ic"><Icon name={r.c} /></span><span class="cat">{r.c}</span><span class="status wip">IN PROGRESS</span></div><h3>{r.t}</h3></div>)}</div>
      </article>
      <aside class="toc" aria-label="On this page">
        <div class="eyebrow" style="margin-bottom:8px">On this page</div>
        {toc.map(([id, l]) => <a href={`#${id}`} data-toc={id}>{l}</a>)}
        <a class="btn btn-primary" style="margin-top:18px;justify-content:center" href="#prompts"><Icon name="copy" />Copy a prompt</a>
      </aside>
    </div>
    <SponsorSlot placement={`category:${u.category}`} label={u.category} />
    <NewsletterSignup />
  </div>
  <script is:inline>
    const links=[...document.querySelectorAll('[data-toc]')];const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){links.forEach(l=>l.classList.toggle('active',l.dataset.toc===e.target.id))}}),{rootMargin:'-20% 0px -70% 0px'});links.forEach(l=>{const t=document.getElementById(l.dataset.toc);t&&io.observe(t)});
  </script>
<style>
  pre.example { white-space: pre-wrap; background: var(--surface, rgba(127,127,127,.08)); border: 1px solid var(--border, rgba(127,127,127,.2)); border-radius: 10px; padding: 14px 16px; font-size: 13.5px; line-height: 1.55; overflow-x: auto; }
</style>
</Base>
